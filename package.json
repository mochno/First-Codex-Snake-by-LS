{
  "name": "snake-game",
  "version": "1.0.0",
  "description": "Snake game desktop wrapper",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.firstproject.snake",
    "productName": "SnakeGame",
    "files": [
      "index.html",
      "main.js"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
